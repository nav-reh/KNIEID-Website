{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "knieid-website",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/members", "/committee", "/login", "/change-password"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "knieid-users",
    "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
